{
  "name": "shiritori-dictionary-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "build:web": "node build-web.mjs",
    "preview": "node serve-web.mjs",
    "format": "prettier --write \"*.mjs\" \"web/**/*.mjs\" \"web/*.html\" \"web/*.css\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.mjs\" \"web/**/*.mjs\" \"web/*.html\" \"web/*.css\" \"scripts/*.mjs\"",
    "lint": "eslint .",
    "verify": "npm run format:check && npm run lint && npm run check && npm test",
    "package:site": "python3 package-site.py",
    "verify:site": "node verify-site.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "linkedom": "^0.18.13",
    "prettier": "3.9.9"
  }
}
